/* Humanitarian Hub TESTNET — /clear-payments
   GET: Lists and cancels all incomplete payments
   Tries cancel first, then approve+complete for stuck ones */

export async function onRequestGet(context) {
  const apiKey = context.env.PI_API_KEY;
  if (!apiKey) {
    return new Response(JSON.stringify({
      error: 'PI_API_KEY not set',
      fix: 'Cloudflare Pages → Settings → Environment Variables → PI_API_KEY'
    }), { status: 200, headers: { 'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*' }});
  }

  const results = [];

  try {
    /* Get incomplete payments */
    const r = await fetch('https://api.minepi.com/v2/payments?payment_type=incomplete', {
      headers: { 'Authorization': `Key ${apiKey}` }
    });
    const data = await r.json();
    console.log('[clear] payments response:', JSON.stringify(data).slice(0, 500));

    const payments = Array.isArray(data) ? data : (data.data || data.payments || []);

    if (!payments.length) {
      return new Response(JSON.stringify({
        success: true,
        cleared: 0,
        message: 'No pending payments — queue is clear! Try making a payment now.',
        raw: data
      }), { status: 200, headers: { 'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*' }});
    }

    for (const p of payments) {
      const pid = p.identifier;
      const hasTxid = p.transaction && p.transaction.txid;
      const txid = hasTxid ? p.transaction.txid : null;
      const devApproved = p.status && p.status.developer_approved;

      let action = 'none';
      let res = null;

      try {
        if (txid) {
          /* Has txid — complete it */
          const cr = await fetch(`https://api.minepi.com/v2/payments/${pid}/complete`, {
            method: 'POST',
            headers: { 'Authorization': `Key ${apiKey}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ txid })
          });
          res = await cr.json();
          action = 'completed';
        } else if (devApproved) {
          /* Approved but no txid — cancel */
          const cr = await fetch(`https://api.minepi.com/v2/payments/${pid}/cancel`, {
            method: 'POST',
            headers: { 'Authorization': `Key ${apiKey}`, 'Content-Type': 'application/json' }
          });
          res = await cr.json();
          action = 'cancelled_after_approve';
        } else {
          /* Not yet approved — cancel directly */
          const cr = await fetch(`https://api.minepi.com/v2/payments/${pid}/cancel`, {
            method: 'POST',
            headers: { 'Authorization': `Key ${apiKey}`, 'Content-Type': 'application/json' }
          });
          res = await cr.json();
          action = 'cancelled';
        }
      } catch(e) {
        action = 'error: ' + e.message;
        res = null;
      }

      results.push({ paymentId: pid, amount: p.amount, action, result: res });
    }

    return new Response(JSON.stringify({
      success: true,
      cleared: results.length,
      message: `Cleared ${results.length} payment(s). Try making a payment now!`,
      results
    }), { status: 200, headers: { 'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*' }});

  } catch(e) {
    return new Response(JSON.stringify({ success: false, error: e.message }), {
      status: 200, headers: { 'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*' }
    });
  }
}

export async function onRequestOptions() {
  return new Response(null, { status: 204, headers: {
    'Access-Control-Allow-Origin': '*',
    'Access-Control-Allow-Methods': 'GET,POST,OPTIONS',
    'Access-Control-Allow-Headers': 'Content-Type,Authorization'
  }});
}
